{
  "name": "ralph-planner",
  "tools": ["*"],
  "allowedTools": ["read", "write", "shell", "subagent"],
  "resources": ["file://docs/ralph.md", "file://AGENTS.md"],
  "hooks": {
    "agentSpawn": [
      {
        "command": "bash -c \"mkdir -p .kiro-logs/$PPID && touch .kiro-logs/$PPID/prompts.txt && echo .kiro-logs/$PPID/prompts.txt\""
      }
    ],
    "userPromptSubmit": [
      {
        "command": "bash -c \"echo \\\"[$(date)] $(jq -r '.prompt')\\\" >> .kiro-logs/$PPID/prompts.txt\""
      }
    ]
  }
}
